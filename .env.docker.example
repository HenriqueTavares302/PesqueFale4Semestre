# Variáveis usadas pelo docker-compose.yml.
# Copie para .env na raiz do projeto antes de rodar docker compose up.
#
# Este arquivo NÃO vai para o Git: o .gitignore já cobre .env.

# Senha do root do MySQL dentro do container.
DB_ROOT_PASSWORD=escolha_uma_senha
DB_NAME=pesque_fale

# Segredo de assinatura dos tokens.
# É o valor mais sensível do projeto: quem o tiver consegue fabricar um
# token válido e entrar como administrador, sem precisar de senha nenhuma.
# Gere o seu, não reaproveite exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=

# Código exigido para criar conta de administrador na API.
CODIGO_ADMIN=escolha_um_codigo

# Endereço público. Em máquina local, http://localhost.
URL_SITE=http://localhost
ORIGENS_PERMITIDAS=http://localhost,http://localhost:3000

# Porta em que o site responde na máquina.
# Use 8080 se a 80 já estiver ocupada por outro programa.
PORTA_WEB=80

# Measurement ID do GA4, no formato G-XXXXXXXXXX.
# Em branco desliga o Analytics.
REACT_APP_GA_ID=
