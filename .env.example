# Variáveis do front-end.
# Copie para .env e preencha. O Create React App só expõe ao navegador as
# variáveis que começam com REACT_APP_.
#
# Atenção: tudo que está aqui vai dentro do JavaScript do build e fica
# visível para qualquer visitante. Senha, segredo de token e chave privada
# nunca entram neste arquivo — esses ficam só em server/.env, que não é
# enviado ao navegador.

# Endereço da API do catálogo.
# Desenvolvimento, com a API rodando em outra porta:
REACT_APP_API_URL=http://localhost:3001
# Em produção atrás do Nginx, use o caminho relativo, que evita CORS:
# REACT_APP_API_URL=/api

# Endereço público do site, usado no canonical e no Open Graph.
REACT_APP_URL_SITE=https://pesqueefaledb.web.app

# Measurement ID do Google Analytics 4, no formato G-XXXXXXXXXX.
# Fica em analytics.google.com → Administrador → Fluxos de dados.
# Deixe em branco para desligar o Analytics: nada é carregado sem ele.
REACT_APP_GA_ID=
