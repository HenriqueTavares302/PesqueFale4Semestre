# Banco de dados
# Em execução local, DB_HOST=localhost.
# Dentro do docker-compose, DB_HOST=banco (o nome do serviço).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="sua_senha_aqui"
DB_NAME=pesque_fale

# Porta da API
PORT=3001

# Endereço público do site, usado no sitemap e no CORS
URL_SITE=https://pesqueefaledb.web.app

# Origens autorizadas a chamar a API, separadas por vírgula
ORIGENS_PERMITIDAS=http://localhost:3000,https://pesqueefaledb.web.app

# Segredo de assinatura dos tokens JWT.
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=troque_por_um_texto_longo_e_aleatorio

# Código exigido para criar uma conta de administrador
CODIGO_ADMIN=troque_este_codigo
